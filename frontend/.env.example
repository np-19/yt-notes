# Backend API URL (for local dev or pointing to your Vercel backend)
# Example production: https://your-backend.vercel.app
VITE_BACKEND_URL=http://localhost:5000

# Hosted Web Studio URL (used by the Chrome Extension to open the full studio tab)
# Example production: https://your-frontend.vercel.app
VITE_WEB_STUDIO_URL=http://localhost:5173
