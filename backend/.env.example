# Server Port (used in local development)
PORT=5000

# Allowed Frontend URLs for CORS (comma-separated or single domain)
# For production on Vercel: set to your Vercel frontend URL, e.g. https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-3.6-flash

# Webshare Residential Proxy (required for YouTube transcript fetching on serverless/cloud hosting)
# Sign up at https://webshare.io and copy your credentials from the proxy list page
WEBSHARE_PROXY_USERNAME=your_webshare_username
WEBSHARE_PROXY_PASSWORD=your_webshare_password
