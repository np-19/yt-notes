# Server Port (used in local development)
PORT=5000

# Allowed Frontend URLs for CORS (comma-separated or single domain)
# For production on Vercel: set to your Vercel frontend URL, e.g. https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model
GEMINI_MODEL=gemini-3.6-flash

# YouTube Transcript API Keys (https://www.youtube-transcript.io/api)
# Supports single key or comma-separated keys from multiple accounts for 25 free tokens/month per account
# Example: YOUTUBE_TRANSCRIPT_API_KEYS=key1,key2,key3
YOUTUBE_TRANSCRIPT_API_KEYS=your_youtube_transcript_api_key_here

